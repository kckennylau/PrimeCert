import PrimeCert

/-! # Example primality certificates

Demonstrates `pock3` and `prime_cert` on primes up to 100+ digits, including the Ed25519
base point order and the Goldilocks prime `2^448 - 2^224 - 1`.

Helpful links:
* https://www.alpertron.com.ar/ECM.HTM (integer factorisation calculator using elliptic curves)
-/

set_option linter.style.longLine false

namespace PrimeCert

theorem prime_16290860017' : Nat.Prime 16290860017 := by prime_cert
  [small {3; 29},
   pock3 (339392917, 2, 3, 2 ^ 2 * 3 ^ 4 * 29),
   pock3 (16290860017, 5, 0, 2 ^ 4 * 3 * 339392917)]

-- randomly generated 60-digit prime
theorem prime_236684654874665389773181956283167565443541280517430278333971 :
    Nat.Prime 236684654874665389773181956283167565443541280517430278333971 := by prime_cert
  [small {2; 3; 7; 11; 29; 31},
  pock3 (73471, 3, 7, 2 * 31),
  pock3 (32560621, 2, 7, 2 ^ 2 * 3 * 29),
  pock3 (3586530508831189, 2, 11, 2 ^ 2 * 73471),
  pock3 (236684654874665389773181956283167565443541280517430278333971,
    2, 3, 2 * 32560621 * 3586530508831189)]

