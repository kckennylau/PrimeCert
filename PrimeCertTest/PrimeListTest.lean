set_option maxRecDepth 1000 in
theorem prime_25519 : Nat.Prime (2 ^ 255 - 19) := by prime_cert
  [small {3; 5; 7; 43},
   pock3 (1923133, 2, 5, 2 ^ 2 * 3 * 43),
   pock3 (430751, 17, 7, 2 * 5 ^ 3),
   pock3 (31757755568855353, 5, 5, 2 ^ 3 * 430751),
   pock3 (74058212732561358302231226437062788676166966415465897661863160754340907, 2, 5, 2 * 3 * 1923133 * 31757755568855353),
   pock3 (57896044618658097711785492504343953926634992332820282019728792003956564819949, 2, 0, 2 ^ 2 * 74058212732561358302231226437062788676166966415465897661863160754340907)]

set_option exponentiation.threshold 448 in
theorem prime_448_224_1 : Nat.Prime (2 ^ 448 - 2 ^ 224 - 1) := by prime_cert
  [small {3; 5; 7; 29; 67; 271; 641},
   pock3 (411743, 5, 3, 2 * 29),
   pock3 (1469495262398780123809, 17, 5, 2 ^ 5 * 411743),
   pock3 (97859369123353, 5, 7, 2 ^ 3 * 67 * 271),
   pock3 (167773885276849215533569, 17, 0, 2 ^ 9 * 97859369123353),
   pock3 (726838724295606890549323807888004534353641360687318060281490199180612328166730772686396383698676545930088884461843637361053498018365439, 7, 3, 2 * 641 * 1469495262398780123809 * 167773885276849215533569)]

-- 1178-digit prime 3 * 2 ^ 3912 + 1 (Proth form), certified with pock3
set_option maxRecDepth 2048 in
set_option exponentiation.threshold 3912 in
example : Nat.Prime (3 * 2 ^ 3912 + 1) := by prime_cert
  [small {3},
   pock3 (, 11, 0, 2 ^ 3912 * 3)]

theorem prime_3999999999999999791 : Nat.Prime 3999999999999999791 := by prime_cert
  [small {3; 5; 23; 211},
   pock3 (239851, 3, 0, 2 * 3 ^ 2 * 5 ^ 2),
   pock3 (399999999999999979, 2, 0, 2 * 3 ^ 3 * 23 * 211 * 239851),
   pock3 (3999999999999999791, 11, 0, 2 * 5 * 399999999999999979)]

theorem prime_3999999999999999691 : Nat.Prime 3999999999999999691 := by prime_cert
  [small {3; 5; 11; 29; 41; 389},
   pock3 (18913, 7, 3, 2 ^ 5 * 3),
   pock3 (37379684141669, 2, 0, 2 ^ 2 * 11 * 389 * 18913),
   pock3 (3999999999999999691, 3, 0, 2 * 3 ^ 2 * 5 * 29 * 41 * 37379684141669)]

